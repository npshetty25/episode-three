# Copy this file to .env and fill in real values. .env is git-ignored; this file is not.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/
MONGODB_DB=episode_three
# Folder with the Kaggle "Anime Recommendation Database 2020" CSVs (kept outside the repo)
MAL_DATA_DIR=C:\path\to\anime-recommendation-database-2020
